# ==========================================
# DevNavigator Environment Configuration
# ==========================================

# ------------------------------------------
# Backend Settings (Render / Local)
# ------------------------------------------
# Required for GraphRAG inference with Google Gemini
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Stripe secret key for Pro subscription tier
STRIPE_SECRET_KEY=sk_test_...

# Clerk backend secret key for JWT verification
CLERK_SECRET_KEY=sk_test_...

# Database path (defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./saas_db.sqlite

# ------------------------------------------
# Frontend Settings (Vercel / Local)
# ------------------------------------------
# Point to your Render backend API URL when deploying to Vercel
# e.g. https://dev-navigator-api.onrender.com (or http://127.0.0.1:8000 for local dev)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Clerk authentication public and secret keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
